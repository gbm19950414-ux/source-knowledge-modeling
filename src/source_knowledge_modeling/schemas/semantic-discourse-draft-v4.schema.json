{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://source-knowledge-modeling.local/contracts/semantic-discourse-draft/v4/schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_sha256",
    "author",
    "directory_status",
    "root_id",
    "containers",
    "blocks",
    "edges",
    "reading_structures",
    "relation_bindings"
  ],
  "properties": {
    "schema_version": {
      "const": "semantic-discourse-draft/v4"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "author": {
      "type": "string",
      "minLength": 1
    },
    "directory_status": {
      "enum": [
        "pending",
        "verified"
      ]
    },
    "root_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "containers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "parent_id",
          "kind",
          "title",
          "order"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "parent_id": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
              },
              {
                "type": "null"
              }
            ]
          },
          "kind": {
            "enum": [
              "chapter",
              "section"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "order": {
            "type": "integer"
          },
          "range": {
            "type": "object",
            "required": [
              "start",
              "end"
            ],
            "properties": {
              "start": {
                "type": "object"
              },
              "end": {
                "type": "object"
              }
            }
          }
        },
        "additionalProperties": false
      }
    },
    "blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "parent_id",
          "title",
          "order",
          "element_ids",
          "content_types",
          "focus_refs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "parent_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "order": {
            "type": "integer"
          },
          "element_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            }
          },
          "related_element_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            }
          },
          "content_types": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "plan_process",
                "concept_principle",
                "parameter_constraint",
                "argument_explanation",
                "comparison",
                "example"
              ]
            }
          },
          "focus_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/source_ref"
            }
          },
          "focus_rationale": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "from_id",
          "to_id",
          "from_element_ids",
          "to_element_ids",
          "direction",
          "origin",
          "premises",
          "relation_form",
          "basis"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "type": {
            "enum": [
              "conditions",
              "exception_to",
              "replaces",
              "supports",
              "precedes",
              "quantifies",
              "example_of",
              "qualifies",
              "causes",
              "contrasts_with",
              "elaborates"
            ]
          },
          "from_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "to_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "from_element_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            }
          },
          "to_element_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            }
          },
          "direction": {
            "enum": [
              "directed",
              "symmetric"
            ]
          },
          "origin": {
            "enum": [
              "source",
              "interpretation"
            ]
          },
          "premises": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "object_id",
                "field_path"
              ],
              "properties": {
                "object_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
                },
                "field_path": {
                  "type": "string",
                  "minLength": 1
                },
                "content_revision": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "additionalProperties": false
            }
          },
          "source_relation_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            }
          },
          "rationale": {
            "type": "string"
          },
          "uncertainty": {
            "type": "string"
          },
          "scope_note": {
            "type": "string"
          },
          "relation_form": {
            "enum": [
              "source_native",
              "source_rollup",
              "project_inference"
            ]
          },
          "basis": {
            "enum": [
              "explicit",
              "inferred_from_source",
              "source_rollup",
              "project_interpretation"
            ]
          },
          "qualifiers": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/qualifier"
            }
          },
          "overall_effect": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "reading_structures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "scope_id",
          "pattern"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "scope_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "pattern": {
            "enum": [
              "sequence",
              "explanation",
              "comparison",
              "multiple"
            ]
          },
          "core_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            }
          },
          "supports": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "node_id",
                "anchor_id",
                "role"
              ],
              "properties": {
                "node_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
                },
                "anchor_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
                },
                "role": {
                  "enum": [
                    "condition",
                    "parameter",
                    "reason",
                    "example",
                    "detail",
                    "exception"
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "independent_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            }
          },
          "reading_order": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            }
          },
          "refs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "object_id",
                "field_path"
              ],
              "properties": {
                "object_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
                },
                "field_path": {
                  "type": "string",
                  "minLength": 1
                },
                "content_revision": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "additionalProperties": false
            }
          },
          "rationale": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "relation_bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source_relation_id",
          "qualifiers"
        ],
        "properties": {
          "source_relation_id": {
            "type": "string",
            "minLength": 1
          },
          "qualifiers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/qualifier"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "source_ref": {
      "type": "object",
      "required": [
        "object_id",
        "field_path"
      ],
      "properties": {
        "object_id": {
          "type": "string",
          "minLength": 1
        },
        "field_path": {
          "type": "string",
          "pattern": "^/"
        },
        "content_revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "qualifier": {
      "type": "object",
      "required": [
        "applies_to",
        "dimension",
        "source_ref"
      ],
      "properties": {
        "applies_to": {
          "enum": [
            "from",
            "to",
            "relation"
          ]
        },
        "dimension": {
          "enum": [
            "condition",
            "time",
            "modality",
            "scope"
          ]
        },
        "source_ref": {
          "$ref": "#/$defs/source_ref"
        }
      },
      "additionalProperties": false
    }
  }
}
