{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://source-knowledge-modeling.local/contracts/knowledge-foundation/v1/knowledge-foundation.schema.json",
  "title": "Source-faithful knowledge foundation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_id", "revision", "source", "scope", "units", "annotations", "relations"],
  "properties": {
    "schema_version": {"const": "knowledge-foundation/v1"},
    "artifact_id": {"$ref": "#/$defs/id"},
    "revision": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "parent_id", "note"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "parent_id": {"oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]}, "note": {"type": "string", "minLength": 1}}
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "title", "path", "sha256", "snapshot_path", "snapshot_sha256", "transcription_method"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "kind": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1}, "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha"}, "snapshot_path": {"type": "string", "minLength": 1},
        "snapshot_sha256": {"$ref": "#/$defs/sha"}, "transcription_method": {"type": "string", "minLength": 1}
      }
    },
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["description", "included_locators", "context_locators", "outside_scope_note"],
      "properties": {
        "description": {"type": "string", "minLength": 1},
        "included_locators": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "context_locators": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "outside_scope_note": {"type": "string", "minLength": 1}
      }
    },
    "units": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/unit"}},
    "annotations": {"type": "array", "items": {"$ref": "#/$defs/annotation"}},
    "relations": {"type": "array", "items": {"$ref": "#/$defs/relation"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "sha": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "review": {
      "type": "object", "additionalProperties": false,
      "required": ["decision", "reviewer", "checked_locators", "check_method", "reviewed_at", "proposal_sha256"],
      "properties": {
        "decision": {"const": "accept"},
        "reviewer": {"type": "string", "minLength": 1},
        "checked_locators": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "check_method": {"enum": ["original_visual", "source_text"]},
        "reviewed_at": {"type": "string", "minLength": 1},
        "proposal_sha256": {"$ref": "#/$defs/sha"}
      }
    },
    "unit": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "order", "kind", "locator", "content_sha256", "transcription_status", "interpretation_status", "review_note"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "order": {"type": "integer", "minimum": 0},
        "kind": {"type": "string", "minLength": 1}, "locator": {"type": "string", "minLength": 1},
        "content_sha256": {"oneOf": [{"$ref": "#/$defs/sha"}, {"type": "null"}]},
        "transcription_status": {"enum": ["verified", "spot_checked", "machine_extracted", "visual_only", "needs_correction", "failed"]},
        "interpretation_status": {"enum": ["interpreted", "partially_interpreted", "unreviewed", "not_applicable"]},
        "review_note": {"type": "string"}
      }
    },
    "annotation": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "origin_type", "role", "summary", "unit_ids", "conditions", "exceptions", "source_checked", "scientific_status"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "origin_type": {"enum": ["source_claim", "source_example", "project_interpretation", "unresolved"]},
        "role": {"type": "string", "minLength": 1}, "summary": {"type": "string", "minLength": 1},
        "unit_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "conditions": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "exceptions": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "source_checked": {"type": "boolean"},
        "scientific_status": {"enum": ["not_assessed", "assessed", "not_applicable"]},
        "applicability_status": {"enum": ["not_assessed", "assessed", "not_applicable"]},
        "review": {"$ref": "#/$defs/review"}
      }
    },
    "relation": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "type", "from_id", "to_id", "support_unit_ids", "origin_type", "source_checked", "note"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "type": {"type": "string", "minLength": 1},
        "from_id": {"$ref": "#/$defs/id"}, "to_id": {"$ref": "#/$defs/id"},
        "support_unit_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "origin_type": {"enum": ["source_claim", "project_interpretation"]},
        "source_checked": {"type": "boolean"}, "note": {"type": "string"},
        "review": {"$ref": "#/$defs/review"}
      }
    }
  }
}
