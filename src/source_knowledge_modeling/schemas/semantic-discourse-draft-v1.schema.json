{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://source-knowledge-modeling.local/contracts/semantic-discourse-draft/v1/schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_sha256",
    "author",
    "chapter",
    "topics",
    "blocks",
    "edges"
  ],
  "properties": {
    "schema_version": {
      "const": "semantic-discourse-draft/v1"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "author": {
      "type": "string",
      "minLength": 1
    },
    "chapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "summary"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "text",
              "origin",
              "refs"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "origin": {
                "enum": [
                  "source",
                  "interpretation"
                ]
              },
              "refs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "object_id",
                    "field_path"
                  ],
                  "properties": {
                    "object_id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
                    },
                    "field_path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "content_revision": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    }
                  }
                }
              },
              "rationale": {
                "type": "string"
              },
              "uncertainty": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "topics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "package_id",
          "title",
          "role",
          "order",
          "summary"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "package_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "mainline",
              "supporting"
            ]
          },
          "order": {
            "type": "integer",
            "minimum": 0
          },
          "summary": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "text",
                "origin",
                "refs"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "origin": {
                  "enum": [
                    "source",
                    "interpretation"
                  ]
                },
                "refs": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "object_id",
                      "field_path"
                    ],
                    "properties": {
                      "object_id": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
                      },
                      "field_path": {
                        "type": "string",
                        "minLength": 1
                      },
                      "content_revision": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      }
                    }
                  }
                },
                "rationale": {
                  "type": "string"
                },
                "uncertainty": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "topic_id",
          "title",
          "order",
          "summary",
          "element_ids"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "topic_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "order": {
            "type": "integer",
            "minimum": 0
          },
          "summary": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "text",
                "origin",
                "refs"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "origin": {
                  "enum": [
                    "source",
                    "interpretation"
                  ]
                },
                "refs": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "object_id",
                      "field_path"
                    ],
                    "properties": {
                      "object_id": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
                      },
                      "field_path": {
                        "type": "string",
                        "minLength": 1
                      },
                      "content_revision": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      }
                    }
                  }
                },
                "rationale": {
                  "type": "string"
                },
                "uncertainty": {
                  "type": "string"
                }
              }
            }
          },
          "element_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            }
          },
          "related_element_ids": {
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            }
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "from_id",
          "to_id",
          "label",
          "direction",
          "origin",
          "premises",
          "source_relation_ids",
          "rationale",
          "uncertainty",
          "scope_note"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "from_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "to_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "direction": {
            "enum": [
              "directed",
              "symmetric",
              "undirected"
            ]
          },
          "origin": {
            "enum": [
              "source",
              "interpretation"
            ]
          },
          "premises": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "object_id",
                "field_path"
              ],
              "properties": {
                "object_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
                },
                "field_path": {
                  "type": "string",
                  "minLength": 1
                },
                "content_revision": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          },
          "source_relation_ids": {
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
            }
          },
          "rationale": {
            "type": "string"
          },
          "uncertainty": {
            "type": "string"
          },
          "scope_note": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
