{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://source-knowledge-modeling.local/contracts/knowledge-semantic-assessment/v1/schema.json",
  "title": "Independent candidate meaning review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "draft_sha256",
    "inventory_sha256",
    "discourse_sha256",
    "reviewer",
    "reviewer_type",
    "model",
    "check_method",
    "checked_at",
    "checks"
  ],
  "properties": {
    "schema_version": {
      "const": "knowledge-semantic-assessment/v1"
    },
    "draft_sha256": {
      "$ref": "#/$defs/sha"
    },
    "inventory_sha256": {
      "$ref": "#/$defs/sha"
    },
    "discourse_sha256": {
      "$ref": "#/$defs/sha"
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "reviewer_type": {
      "enum": [
        "AI",
        "human"
      ]
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "check_method": {
      "enum": [
        "original_visual",
        "source_text"
      ]
    },
    "checked_at": {
      "type": "string",
      "minLength": 1
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target_kind",
          "target_id",
          "verdict",
          "reason"
        ],
        "properties": {
          "target_kind": {
            "enum": [
              "information",
              "discourse",
              "element",
              "relation"
            ]
          },
          "target_id": {
            "type": "string",
            "minLength": 1
          },
          "verdict": {
            "enum": [
              "pass",
              "fail",
              "gap",
              "uncertain",
              "not_stated",
              "not_applicable",
              "pending"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "content_revision": {
            "$ref": "#/$defs/sha"
          }
        }
      }
    }
  },
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
