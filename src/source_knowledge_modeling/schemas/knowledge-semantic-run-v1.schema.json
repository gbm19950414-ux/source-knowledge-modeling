{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://source-knowledge-modeling.local/contracts/knowledge-semantic-run/v1/schema.json",
  "title": "Frozen workspace run index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "input_fingerprint", "inputs", "tool", "profile", "prepare_inputs", "records", "execution"],
  "properties": {
    "schema_version": {"const": "knowledge-semantic-run/v1"},
    "input_fingerprint": {"$ref": "#/$defs/sha"}, "inputs": {"type": "object"},
    "tool": {"type": "object", "additionalProperties": false, "required": ["name", "version", "implementation_sha256"],
      "properties": {"name": {"type": "string"}, "version": {"type": "string"}, "implementation_sha256": {"$ref": "#/$defs/sha"}}},
    "profile": {"type": "object", "required": ["id", "version", "definition_sha256"]},
    "prepare_inputs": {"type": "object", "required": ["foundation", "scope"], "additionalProperties": {"$ref": "#/$defs/hashed_ref"}},
    "records": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["command", "arguments", "inputs", "output"],
      "properties": {"command": {"type": "string", "minLength": 1}, "arguments": {"type": "object"},
        "inputs": {"type": "object", "additionalProperties": {"$ref": "#/$defs/hashed_ref"}}, "input_snapshots": {"type": "object", "additionalProperties": {"$ref": "#/$defs/hashed_ref"}}, "derived": {"type": "object", "additionalProperties": {"$ref": "#/$defs/hashed_ref"}}, "output": {"$ref": "#/$defs/hashed_ref"}}}},
    "execution": {"type": "object", "additionalProperties": false,
      "required": ["executor", "model", "interventions", "retries"],
      "properties": {
        "executor": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "interventions": {"type": "array", "items": {"type": "object", "required": ["description"],
          "properties": {"description": {"type": "string", "minLength": 1}, "actor": {"type": "string"}, "at": {"type": "string"}}}},
        "retries": {"type": "array", "items": {"type": "object", "required": ["command", "output", "reason"],
          "properties": {"command": {"type": "string", "minLength": 1}, "output": {"type": "string", "minLength": 1}, "reason": {"type": "string", "minLength": 1}}}}
      }}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "hashed_ref": {"type": "object", "additionalProperties": false, "required": ["location", "path", "sha256"],
      "properties": {"location": {"enum": ["run", "root"]}, "path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha"}}}
  }
}
