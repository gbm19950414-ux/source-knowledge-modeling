{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://source-knowledge-modeling.local/contracts/knowledge-semantic-projection/v1/schema.json",
  "title": "Source-linked semantic projection v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "artifact_id", "revision", "profile", "source", "legacy", "scope", "screening", "statements", "lineage", "supersessions"],
  "properties": {
    "schema_version": {"const": "knowledge-semantic-projection/v1"},
    "artifact_id": {"$ref": "#/$defs/id"},
    "revision": {"type": "object", "additionalProperties": false, "required": ["id", "parent_id", "note"], "properties": {
      "id": {"$ref": "#/$defs/id"}, "parent_id": {"type": ["string", "null"]}, "note": {"type": "string"}}},
    "profile": {"type": "object", "additionalProperties": false, "required": ["id", "version", "definition_sha256"], "properties": {
      "id": {"$ref": "#/$defs/id"}, "version": {"type": "string", "minLength": 1}, "definition_sha256": {"$ref": "#/$defs/sha"}}},
    "source": {"type": "object", "additionalProperties": true, "required": ["id", "kind", "title", "path", "sha256", "snapshot_path", "snapshot_sha256"], "properties": {
      "id": {"$ref": "#/$defs/id"}, "kind": {"type": "string"}, "title": {"type": "string"}, "path": {"type": "string"},
      "sha256": {"$ref": "#/$defs/sha"}, "snapshot_path": {"type": "string"}, "snapshot_sha256": {"$ref": "#/$defs/sha"}}},
    "legacy": {"type": "object", "additionalProperties": false, "required": ["artifact_id", "revision_id", "sha256", "profile_status"], "properties": {
      "artifact_id": {"$ref": "#/$defs/id"}, "revision_id": {"$ref": "#/$defs/id"}, "sha256": {"$ref": "#/$defs/sha"}, "profile_status": {"const": "legacy/unversioned"}}},
    "scope": {"type": "object", "additionalProperties": true, "required": ["included_locators", "description"], "properties": {
      "included_locators": {"type": "array", "items": {"type": "string"}}, "description": {"type": "string"}}},
    "screening": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["locator", "status", "reason"], "properties": {
      "locator": {"type": "string", "minLength": 1}, "status": {"enum": ["modeled", "partial", "unmodeled", "uncertain", "not_applicable"]}, "reason": {"type": "string", "minLength": 1}}}},
    "statements": {"type": "array", "items": {"$ref": "#/$defs/statement"}},
    "lineage": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["legacy_kind", "legacy_id", "status", "new_ids"], "properties": {
      "legacy_kind": {"enum": ["annotation", "relation"]}, "legacy_id": {"$ref": "#/$defs/id"}, "status": {"enum": ["rebuilt", "partial", "deferred"]},
      "new_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}}}},
    "supersessions": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["from_revision", "old_ids", "new_ids"], "properties": {
      "from_revision": {"$ref": "#/$defs/id"}, "old_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
      "new_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}}}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "sha": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "anchor": {"type": "object", "additionalProperties": false, "required": ["locator", "start", "end", "quote"], "properties": {
      "locator": {"type": "string", "minLength": 1}, "start": {"type": "integer", "minimum": 0},
      "end": {"type": "integer", "minimum": 1}, "quote": {"type": "string", "minLength": 1}}},
    "element": {"type": "object", "additionalProperties": false, "required": ["id", "kind", "text", "anchors"], "properties": {
      "id": {"$ref": "#/$defs/id"}, "kind": {"enum": ["assertion", "action", "condition", "exception", "reason", "parameter", "example", "unresolved"]},
      "text": {"type": "string", "minLength": 1}, "anchors": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/anchor"}},
      "quantity": {"type": "object", "additionalProperties": false, "required": ["amount", "unit", "basis"], "properties": {
        "amount": {"type": "string", "minLength": 1}, "unit": {"type": "string", "minLength": 1}, "basis": {"type": "string", "minLength": 1}}}}},
    "relation": {"type": "object", "additionalProperties": false, "required": ["id", "type", "from_id", "to_id", "anchors", "note"], "properties": {
      "id": {"$ref": "#/$defs/id"}, "type": {"enum": ["conditions", "exception_to", "replaces", "supports", "precedes", "quantifies", "example_of", "qualifies"]},
      "from_id": {"$ref": "#/$defs/id"}, "to_id": {"$ref": "#/$defs/id"},
      "anchors": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/anchor"}}, "note": {"type": "string"}}},
    "review": {"type": "object", "additionalProperties": false, "required": ["decision", "reviewer", "check_method", "checked_anchors", "reviewed_at", "proposal_sha256", "note"], "properties": {
      "decision": {"const": "accept"}, "reviewer": {"type": "string", "minLength": 1}, "check_method": {"enum": ["original_visual", "source_text"]},
      "checked_anchors": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/sha"}},
      "reviewed_at": {"type": "string", "minLength": 1}, "proposal_sha256": {"$ref": "#/$defs/sha"}, "note": {"type": "string"}}},
    "statement": {"type": "object", "additionalProperties": false, "required": ["id", "summary", "origin_type", "modality", "legacy_ids", "elements", "relations", "scientific_status", "applicability_status", "review"], "properties": {
      "id": {"$ref": "#/$defs/id"}, "summary": {"type": "string", "minLength": 1},
      "origin_type": {"enum": ["source_claim", "source_example", "project_interpretation", "unresolved"]},
      "modality": {"enum": ["asserted", "recommended", "possible", "hypothetical", "negated", "unresolved"]},
      "legacy_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
      "elements": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/element"}},
      "relations": {"type": "array", "items": {"$ref": "#/$defs/relation"}},
      "scientific_status": {"enum": ["not_assessed", "assessed", "not_applicable"]},
      "applicability_status": {"enum": ["not_assessed", "assessed", "not_applicable"]},
      "review": {"$ref": "#/$defs/review"}}}
  }
}
